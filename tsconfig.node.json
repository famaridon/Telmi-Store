{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2023"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@domain/*": [
        "./src/domain/*"
      ],
      "@app/*": [
        "./src/application/*"
      ],
      "@infra/*": [
        "./src/infrastructure/*"
      ],
      "@shared/*": [
        "./src/shared/*"
      ]
    }
  },
  "include": [
    "electron.vite.config.ts",
    "vitest.config.ts",
    "src/domain/**/*",
    "src/application/**/*",
    "src/infrastructure/**/*",
    "src/shared/**/*",
    "src/main/**/*",
    "src/preload/**/*",
    "tests/**/*"
  ]
}
