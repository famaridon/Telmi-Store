{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "types": [
      "vite/client"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@domain/*": [
        "./src/domain/*"
      ],
      "@shared/*": [
        "./src/shared/*"
      ],
      "@renderer/*": [
        "./src/renderer/src/*"
      ]
    }
  },
  "include": [
    "src/renderer/**/*",
    "src/domain/**/*",
    "src/shared/**/*",
    "src/preload/index.d.ts"
  ]
}
